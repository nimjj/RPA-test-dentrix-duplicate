# Copy to .env and adjust. Every value has a default, so `docker compose up` also works without it.

# ---- Ports on your machine
FRONTEND_PORT=8080        # the app: http://localhost:8080
BACKEND_PORT=8000         # direct API access, e.g. http://localhost:8000/api/health
MAILPIT_UI_PORT=8025      # MFA emails: http://localhost:8025
MAILPIT_SMTP_PORT=1025

# ---- Seed data
SEED_PASSWORD=LedgerLab!2026          # password of every seeded user
# Organization trusted IPs at (re)seed time. The default is a documentation range nobody uses,
# so by default every login from a new browser goes through MFA. Edit later on Dev Settings.
DEFAULT_TRUSTED_IPS=203.0.113.0/24

# ---- CAPTCHA
# off        no widget, no check (early development)
# test       real Google reCAPTCHA checkbox using Google's official localhost test keys (default, works immediately)
# enterprise real Google reCAPTCHA Enterprise checkbox + server-side assessment
CAPTCHA_PROVIDER=test
# Starting mode (changeable on Dev Settings): never | new_device | after_flag | always
CAPTCHA_MODE=new_device
# Only needed when CAPTCHA_PROVIDER=enterprise (see README: "Create the reCAPTCHA key")
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=

# ---- MFA
MFA_SMS_STEP=true                     # second code "by SMS" (shown on /dev/sms)

# ---- Sessions and bot detection (starting values, changeable on Dev Settings)
IDLE_TIMEOUT_MINUTES=15
BOT_DETECTION=true
BOT_MAX_REQUESTS_PER_MIN=60
BOT_MIN_ACTION_MS=400
BOT_FLAG_FORCES_MFA=true
